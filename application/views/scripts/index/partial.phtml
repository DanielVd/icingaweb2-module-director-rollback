<div class="content">
    <h1><?= $this->escape($this->translate('Partial rollback')) ?></h1>
    <p><a href="<?= $this->escape((string) $this->overviewUrl) ?>">
        <?= $this->escape($this->translate('Back to all changes')) ?>
    </a></p>
    <?php if ($this->error !== null): ?>
        <p class="error"><?= $this->escape($this->error) ?></p>
    <?php endif ?>
    <?php
    $labels = [
        'restore' => $this->translate('Restore previous state'),
        'recreate' => $this->translate('Recreate deleted object'),
        'remove' => $this->translate('Remove new object'),
    ];
    ?>
    <?php if ($this->selection !== null): ?>
        <h2><?= $this->escape($this->translate('Review selected changes')) ?></h2>
        <table class="common-table">
            <thead>
                <tr>
                    <?php foreach (['Object type', 'Object', 'Scope', 'Proposed action', 'Included as', 'Changes'] as $label): ?>
                        <th><?= $this->escape($this->translate($label)) ?></th>
                    <?php endforeach ?>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($this->selection['rows'] as $row): ?>
                    <tr>
                        <td><?= $this->escape($row['type']) ?></td>
                        <td><?= $this->escape($row['name']) ?></td>
                        <td><?= $this->escape($row['scope']) ?></td>
                        <td><?= $this->escape($labels[$row['operation']]) ?></td>
                        <td>
                            <?php if (in_array($row['firstId'], $this->selection['requested'], true)): ?>
                                <?= $this->escape($this->translate('Selected')) ?>
                            <?php endif ?>
                            <?php foreach ($this->selection['reasons'][$row['firstId']] ?? [] as $reason): ?>
                                <div><?= $this->escape(sprintf(
                                    $reason['operation'] === 'remove'
                                        ? $this->translate('Required before removing %s')
                                        : $this->translate('Required to restore %s'),
                                    $reason['name']
                                )) ?></div>
                            <?php endforeach ?>
                        </td>
                        <td><?php $diff = $this->diffs[$row['firstId']] ?? []; include __DIR__ . '/diff.phtml'; ?></td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
        <p><?= $this->escape($this->translate('The active deployment is unchanged. Other pending changes stay pending.')) ?></p>
        <?= $this->rollbackForm ?>
        <p><a href="<?= $this->escape((string) $this->selectionUrl) ?>">
            <?= $this->escape($this->translate('Change selection')) ?>
        </a></p>
    <?php elseif ($this->choices): ?>
        <p><?= $this->escape($this->translate('Select the objects to roll back. The preview includes any required dependencies.')) ?></p>
        <form action="<?= $this->escape((string) $this->selectionUrl) ?>" method="post">
            <table class="common-table">
                <thead>
                    <tr>
                        <?php foreach (['Object type', 'Object', 'Scope', 'Proposed action'] as $label): ?>
                            <th><?= $this->escape($this->translate($label)) ?></th>
                        <?php endforeach ?>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($this->choices as $row): ?>
                        <tr>
                            <td><?= $this->escape($row['type']) ?></td>
                            <td>
                                <label><input type="checkbox" name="objects[]" value="<?= $this->escape($row['firstId']) ?>">
                                    <?= $this->escape($row['name']) ?>
                                </label>
                            </td>
                            <td><?= $this->escape($row['scope']) ?></td>
                            <td><?= $this->escape($labels[$row['operation']]) ?></td>
                        </tr>
                    <?php endforeach ?>
                </tbody>
            </table>
            <button type="submit"><?= $this->escape($this->translate('Review selection')) ?></button>
        </form>
    <?php elseif ($this->error === null): ?>
        <p><?= $this->escape($this->translate('There are no objects eligible for partial rollback.')) ?></p>
    <?php endif ?>
</div>
