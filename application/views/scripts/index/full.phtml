<div class="content">
    <h1><?= $this->escape($this->translate('Review full rollback')) ?></h1>
    <p><a href="<?= $this->escape((string) $this->overviewUrl) ?>">
        <?= $this->escape($this->translate('Back to all changes')) ?>
    </a></p>
    <?php if ($this->error !== null): ?>
        <p class="error"><?= $this->escape($this->error) ?></p>
    <?php elseif ($this->rows): ?>
        <p><?= $this->escape(sprintf(
            $this->translate('This rollback affects %d objects. The active deployment #%d stays unchanged.'),
            count($this->rows),
            $this->deploymentId
        )) ?></p>
        <?php
        $labels = [
            'restore' => $this->translate('Restore previous state'),
            'recreate' => $this->translate('Recreate deleted object'),
            'remove' => $this->translate('Remove new object'),
        ];
        $counts = array_count_values(array_column($this->rows, 'operation'));
        ?>
        <ul>
            <?php foreach ($labels as $operation => $label): ?>
                <?php if (isset($counts[$operation])): ?>
                    <li><?= $this->escape(sprintf('%s (%d)', $label, $counts[$operation])) ?></li>
                <?php endif ?>
            <?php endforeach ?>
        </ul>
        <table class="common-table">
            <thead><tr>
                <?php foreach (['Object type', 'Object', 'Scope', 'Proposed action', 'Changes'] as $label): ?>
                    <th><?= $this->escape($this->translate($label)) ?></th>
                <?php endforeach ?>
            </tr></thead>
            <tbody>
                <?php foreach ($this->rows as $row): ?>
                    <tr>
                        <td><?= $this->escape($row['type']) ?></td>
                        <td><?= $this->escape($row['name']) ?></td>
                        <td><?= $this->escape($row['scope']) ?></td>
                        <td><?= $this->escape($labels[$row['operation']]) ?></td>
                        <td><?php $diff = $this->diffs[$row['firstId']] ?? []; include __DIR__ . '/diff.phtml'; ?></td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
        <?= $this->rollbackForm ?>
    <?php endif ?>
</div>
