<?php use Icinga\Web\Url; ?>
<div class="content">
    <h1><?= $this->escape($this->translate('Rollback preview')) ?></h1>
    <?php if ($this->preview === null): ?>
        <p><?= $this->escape($this->translate('The active deployment or its activity log checkpoint could not be verified.')) ?></p>
    <?php else: ?>
        <?php $preview = $this->preview; ?>
        <p><?= $this->escape(sprintf(
            $this->translate('Active deployment #%d, activity log checkpoint #%d.'),
            $preview['deploymentId'],
            $preview['baseline']
        )) ?></p>
        <?php if ($this->partialUrl !== null): ?>
            <p><a href="<?= $this->escape((string) $this->partialUrl) ?>">
                <?= $this->escape($this->translate('Select objects for rollback')) ?>
            </a></p>
        <?php endif ?>
        <?php if ($this->rollbackForm !== null): ?>
            <p><?= $this->escape($this->translate('Applying this plan rolls back all pending changes without deploying.')) ?></p>
            <?= $this->rollbackForm ?>
        <?php elseif ($preview['count'] > 0 && ! $preview['canApply']): ?>
            <p><?= $this->escape($this->translate('Full rollback is unavailable while entries require review.')) ?></p>
        <?php endif ?>
        <?php if ($preview['count'] === 0): ?>
            <p><?= $this->escape($this->translate('No rollback operations or entries requiring review.')) ?></p>
        <?php else: ?>
            <p><?= $this->escape(sprintf(
                $this->translate('Rollback plan entries: %d'),
                $preview['count']
            )) ?></p>
            <table class="common-table table-row-selectable">
                <thead>
                    <tr>
                        <?php foreach (['Object type', 'Object', 'Scope', 'Proposed action', 'Activities'] as $label): ?>
                            <th><?= $this->escape($this->translate($label)) ?></th>
                        <?php endforeach ?>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    $labels = [
                        'restore' => $this->translate('Restore previous state'),
                        'recreate' => $this->translate('Recreate deleted object'),
                        'remove' => $this->translate('Remove new object'),
                        'review' => $this->translate('Review required'),
                    ];
                    ?>
                    <?php foreach ($preview['rows'] as $row): ?>
                        <tr>
                            <td><?= $this->escape($row['type']) ?></td>
                            <td><?= $this->escape($row['name']) ?></td>
                            <td><?= $this->escape($row['scope']) ?></td>
                            <td><?= $this->escape($labels[$row['operation']]) ?></td>
                            <td><?= $this->escape($row['activityCount']) ?></td>
                        </tr>
                    <?php endforeach ?>
                </tbody>
            </table>
            <?php if ($preview['pages'] > 1): ?>
                <?php $url = Url::fromRequest(); ?>
                <p>
                    <?php if ($preview['page'] > 1): ?>
                        <a href="<?= $this->escape((string) $url->with('page', $preview['page'] - 1)) ?>">
                            <?= $this->escape($this->translate('Previous')) ?>
                        </a>
                    <?php endif ?>
                    <?= $this->escape(sprintf($this->translate('Page %d of %d'), $preview['page'], $preview['pages'])) ?>
                    <?php if ($preview['page'] < $preview['pages']): ?>
                        <a href="<?= $this->escape((string) $url->with('page', $preview['page'] + 1)) ?>">
                            <?= $this->escape($this->translate('Next')) ?>
                        </a>
                    <?php endif ?>
                </p>
            <?php endif ?>
        <?php endif ?>
    <?php endif ?>
</div>
